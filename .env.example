# Never commit real values.

# Chain
CHAIN_ID=11155111
RPC_URL=
CONFIRMATIONS=0
GAS_RESERVE_WEI=10000000000000000
GAS_MARGIN_PERCENT=120
RECEIPT_TIMEOUT_MS=180000
INVENTORY_SETTLE_ATTEMPTS=3

# Uniswap on Sepolia. Confirm the router against a Trading API response.
UNIVERSAL_ROUTER_ADDRESS=0x7E4f6c5e954Da5c61B3423D81E2277431Ac043f3
WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
TOKEN_OUT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
UNISWAP_API_KEY=
UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1
TOKEN_OUT_DECIMALS=6

# Execution limits
MAX_SLIPPAGE_BPS_CAP=100
FEE_BPS=10
DEPOSIT_SESSION_TTL_SEC=900
SESSION_GRANT_TTL_SEC=1800
MAX_EXPIRY_FUTURE_SEC=300
MAX_CLOCK_SKEW_SEC=60
MAX_BODY_SIZE_BYTES=16384
MAX_AMOUNT_NATIVE_WEI=1000000000000000000

# Price checks: one quote per interval, sized by the reference amount
PRICE_POLL_INTERVAL_SEC=5
PRICE_REFERENCE_AMOUNT_WEI=100000000000000000
PRICE_QUOTE_TIMEOUT_MS=10000

# Gas limit includes the executor margin: 900000 estimated at 120% needs 1080000.
SIGNING_MAX_GAS=1200000
SIGNING_MAX_FEE_PER_GAS=100000000000
SIGNING_MAX_PRIORITY_FEE_PER_GAS=10000000000
SIGNING_MAX_NATIVE_VALUE_WEI=1000000000000000000

# Operator seeding: set to false after setup
ADMIN_ADDRESS=
SEEDING_ENABLED=true

# Enclave
SIM_MODE=false
ALLOWED_ORIGIN=

# Server and state
HOST=127.0.0.1
PORT=8787
JOURNAL_PATH=journal/enclave.journal
INVENTORY_EOA_COUNT=4
# true only for the first boot. A restart must refuse to create new keys if its state is missing.
CUSTODY_ALLOW_CREATE=false

# Margin trading. In simulation it uses in-memory stand-in accounting until Felix's service lands.
MARGIN_ENABLED=false

# Optional ETH-only escape hatch; leave unset until its contract is deployed.
# ESCAPE_HATCH_ADDRESS=0x...

# Where custody state lives. These are read only in the matching mode.
# SIM_MODE=true: SIM_VAULT_PATH=journal/custody.sim SIM_SEALING_KEY=<64 hex characters>
# SIM_MODE=false: KMS_KEY_ARN=<arn> KMS_REGION=<region> VAULT_ID=<id>
