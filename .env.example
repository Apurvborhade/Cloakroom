# Described in docs/deployment.md. Never commit real values.

# Chain
CHAIN_ID=11155111
RPC_URL=
CONFIRMATIONS=2
GAS_RESERVE_WEI=10000000000000000

# Uniswap: addresses from the Uniswap docs for the chosen chain
UNIVERSAL_ROUTER_ADDRESS=
WETH_ADDRESS=
TOKEN_OUT_ADDRESS=
