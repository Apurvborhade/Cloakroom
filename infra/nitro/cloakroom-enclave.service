[Unit]
Description=Cloakroom Nitro enclave
Requires=nitro-enclaves-allocator.service
Wants=cloakroom-storage.service cloakroom-kms.service cloakroom-uniswap.service cloakroom-rpc.service cloakroom-config.service cloakroom-proxy.service
After=nitro-enclaves-allocator.service cloakroom-storage.service cloakroom-kms.service cloakroom-uniswap.service cloakroom-rpc.service cloakroom-config.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=ENCLAVE_CID=16
Environment=ENCLAVE_MEMORY=2048
EnvironmentFile=-/etc/cloakroom/parent.env
WorkingDirectory=/opt/cloakroom
ExecStart=/usr/bin/nitro-cli run-enclave --cpu-count 1 --memory ${ENCLAVE_MEMORY} --enclave-cid ${ENCLAVE_CID} --enclave-name cloakroom-attestation --eif-path /opt/cloakroom/current/attestation.eif
ExecStop=/usr/bin/nitro-cli terminate-enclave --enclave-name cloakroom-attestation
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
