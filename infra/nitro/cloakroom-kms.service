[Unit]
Description=Cloakroom raw KMS TLS relay
After=network-online.target
Wants=network-online.target

[Service]
Environment=ENCLAVE_CID=16
EnvironmentFile=/etc/cloakroom/parent.env
ExecStart=/usr/bin/python3 /opt/cloakroom/nitro/kms-relay.py parent --region ${AWS_REGION} --cid ${ENCLAVE_CID}
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
