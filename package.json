{
  "name": "cloakroom",
  "version": "0.0.0",
  "private": true,
  "description": "TEE private intent network",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm --filter '@cloakroom/*' run build",
    "typecheck": "pnpm --filter @cloakroom/shared run build && pnpm --filter '@cloakroom/*' run typecheck",
    "test": "pnpm --filter @cloakroom/shared run build && vitest run",
    "test:watch": "pnpm --filter @cloakroom/shared run build && vitest",
    "test:hpke:browser": "pnpm --filter @cloakroom/shared build && pnpm --filter @cloakroom/enclave build && node scripts/check-hpke-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "0.28.2",
    "fast-check": "^3.23.0",
    "playwright": "1.65.0",
    "typescript": "^5.7.0",
    "viem": "^2.57.16",
    "vitest": "^3.0.0"
  }
}
