{
  "name": "cloakroom",
  "version": "0.0.0",
  "private": true,
  "description": "TEE private intent network",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm --filter '@cloakroom/*' run build",
    "typecheck": "pnpm --filter @cloakroom/shared --filter @cloakroom/attestation --filter @cloakroom/enclave run build && pnpm --filter '@cloakroom/*' run typecheck",
    "test": "pnpm --filter @cloakroom/shared run build && vitest run --test-timeout=15000",
    "test:watch": "pnpm --filter @cloakroom/shared run build && vitest --test-timeout=15000",
    "test:hpke:browser": "pnpm --filter @cloakroom/shared build && pnpm --filter @cloakroom/enclave build && node scripts/check-hpke-browser.mjs",
    "test:contracts": "forge test --root contracts",
    "test:escape": "pnpm --filter @cloakroom/shared build && tsx services/enclave/scripts/escape-roundtrip.ts && vitest run --config vitest.escape.config.ts",
    "smoke:sepolia": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/sepolia-smoke.ts",
    "smoke:quote": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/quote-check.ts",
    "smoke:swap": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/swap-smoke.ts",
    "seed:claim": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/seed-inventory.ts claim",
    "seed:fund": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/seed-inventory.ts fund",
    "start:enclave": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/src/main.ts",
    "test:roundtrip": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/roundtrip.ts",
    "test:swap": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/swap-roundtrip.ts",
    "demo:local": "pnpm --filter @cloakroom/shared run build && tsx services/enclave/scripts/demo-fixture.ts local",
    "demo:sepolia": "pnpm --filter @cloakroom/shared run build && tsx --env-file=.env services/enclave/scripts/demo-fixture.ts sepolia"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "0.28.2",
    "fast-check": "^3.23.0",
    "playwright": "1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "viem": "^2.57.16",
    "vitest": "^3.0.0"
  }
}
