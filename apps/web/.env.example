# Cloakroom web app. Every NEXT_PUBLIC_ value ships to the browser: never put a private key,
# API key or any other secret here. Copy to .env.local and fill in.

# --- Enclave API -------------------------------------------------------------------------
# Base URL of the enclave service (services/enclave). The enclave's ALLOWED_ORIGIN must be this
# app's origin, e.g. http://localhost:3000, or the browser's requests are refused by CORS.
NEXT_PUBLIC_CLOAKROOM_API_URL=http://127.0.0.1:8787

# Accept the unattested key from GET /sim/enclave-key when /attestation is unavailable.
# Only for a SIM_MODE=true enclave. Leave false for anything that should be a real TEE.
NEXT_PUBLIC_ALLOW_SIMULATED_ENCLAVE=false

# --- Chain -------------------------------------------------------------------------------
# Must equal the enclave's CHAIN_ID. 11155111 is Sepolia; 31337 is a local Anvil chain.
NEXT_PUBLIC_CHAIN_ID=11155111
# Optional. Defaults to the chain's known explorer (Etherscan for Sepolia).
NEXT_PUBLIC_EXPLORER_URL=

# --- Tokens and limits (mirror the enclave's .env) --------------------------------------
# The enclave's TOKEN_OUT_ADDRESS and TOKEN_OUT_DECIMALS (Sepolia USDC below).
NEXT_PUBLIC_TOKEN_OUT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_TOKEN_OUT_SYMBOL=USDC
NEXT_PUBLIC_TOKEN_OUT_DECIMALS=6
# The enclave's MAX_AMOUNT_NATIVE_WEI, FEE_BPS and MAX_SLIPPAGE_BPS_CAP. Used for validation and
# display only; the enclave enforces its own values.
NEXT_PUBLIC_MAX_AMOUNT_NATIVE_WEI=1000000000000000000
NEXT_PUBLIC_FEE_BPS=10
NEXT_PUBLIC_MAX_SLIPPAGE_BPS_CAP=100
# Optional Uniswap v3 pool (WETH/output token) whose spot price is shown beside price inputs,
# read on-chain through the chain reader. Reference only.
NEXT_PUBLIC_UNISWAP_POOL_ADDRESS=

# --- Wallets -----------------------------------------------------------------------------
# Optional. Without it only injected browser wallets (MetaMask, Rabby, Brave, EIP-6963) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Browser chain reads -----------------------------------------------------------------
# anon-rpc (default): every browser chain read goes through the Anon-RPC browser harness.
# direct-dev: reads go straight to NEXT_PUBLIC_DEV_DIRECT_RPC_URL and the UI labels them as NOT
#             anonymized. For local development only.
# There is no silent fallback: if anon-rpc is selected but misconfigured, chain reads are off.
NEXT_PUBLIC_CHAIN_READ_MODE=anon-rpc
# The on-chain IWorkerSpecifier contract that pins the anon-client bundle by hash. This is Nox, whose
# specifier is on Sepolia, so bootstrap reads Sepolia. tor-js and Nym are on mainnet: see the adopters list.
NEXT_PUBLIC_ANON_RPC_SPECIFIER_ADDRESS=0x35133267A8F7EC35046a83DCA0f4Ca8A6e1b7A9A
# The JSON-RPC endpoint the anon-client forwards reads to (for NEXT_PUBLIC_CHAIN_ID).
NEXT_PUBLIC_ANON_RPC_TARGET_URL=https://ethereum-sepolia-rpc.publicnode.com
# RPC used once, by the harness, to read the specifier contract (on the chain the specifier lives on).
NEXT_PUBLIC_ANON_RPC_BOOTSTRAP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional JSON passed to the worker as its config, e.g. {"network":"sepolia"}. Schema is the worker's.
NEXT_PUBLIC_ANON_RPC_WORKER_CONFIG=
# Only read when NEXT_PUBLIC_CHAIN_READ_MODE=direct-dev. Use a keyless public endpoint.
NEXT_PUBLIC_DEV_DIRECT_RPC_URL=

# --- Margin ------------------------------------------------------------------------------
# auto: show margin and detect whether the enclave serves it. off: hide it entirely.
NEXT_PUBLIC_MARGIN_UI=auto
# Leverage cap in basis points (40000 = 4x). Values above the documented 4x MVP scope are ignored.
NEXT_PUBLIC_MARGIN_MAX_LEVERAGE_BPS=40000
